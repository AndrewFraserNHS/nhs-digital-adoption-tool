{
  "name": "nhs-digital-adoption",
  "version": "6.0.1",
  "private": true,
  "description": "Static NHS Digital Adoption and Change Readiness tools (componentised)",
  "homepage": "https://andrewfrasernhs.github.io/nhs-digital-adoption-tool/",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "lint": "eslint '**/*.{js,ts}' --fix || true",
    "format": "prettier --write '**/*.{js,ts,css,html,json,md}'"
  },
  "dependencies": {
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "chart.js": "^4.4.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-router-dom": "^6.30.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.17",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "gh-pages": "^5.0.0",
    "jsdom": "^29.1.1",
    "node-html-parser": "^9.0.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.0.0",
    "puppeteer": "^25.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.0.0",
    "vitest": "^2.1.9"
  }
}
